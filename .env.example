# Cadangan/sinkronisasi cloud bersifat OPSIONAL.
# Kosongkan keduanya untuk menjalankan aplikasi 100% lokal (mode bawaan).
# Untuk mengaktifkan: salin file ini ke `.env.local`, isi nilai dari proyek
# Supabase Anda (Project Settings → API), lalu build ulang. Anon key memang
# bersifat publik — keamanan datanya dijaga oleh Row Level Security (RLS).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
